{
  "name": "my-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "check:supabase": "node scripts/check-supabase.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:client": "node scripts/check-client-boundaries.mjs",
    "check:email": "node scripts/check-email-provider.mjs",
    "check:paystack": "node scripts/check-paystack.mjs",
    "verify:deploy": "node scripts/verify-deploy-build.mjs",
    "auth:google": "node scripts/google-oauth-setup.mjs",
    "email:test": "node --conditions=react-server scripts/send-test-email.mjs",
    "email:smtp": "node scripts/configure-auth-smtp.mjs",
    "email:smtp:verify": "node scripts/configure-auth-smtp.mjs --verify",
    "email:probe:smtp": "node scripts/probe-mailgun-smtp.mjs",
    "auth:verify": "node scripts/verify-password-auth.mjs",
    "db:apply": "node scripts/db-apply.mjs",
    "db:schema": "node scripts/db-schema.mjs",
    "db:verify": "node scripts/verify-rls.mjs",
    "db:catalog": "node scripts/catalog-probe.mjs",
    "db:probe:checkout": "node scripts/probe-checkout-rpc.mjs",
    "db:reseed": "node scripts/generate-reseed.mjs",
    "images:update": "node scripts/update-product-images.ts",
    "test:unit": "node --conditions=react-server --import ./tests/register.mjs --test tests/*.test.ts",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
