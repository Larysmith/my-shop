# Same two values as NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY in the shop's .env.local — the app and the
# website must point at the same Supabase project, or they are different accounts
# and the carts cannot meet.
#
# Copy to .env and fill in. .env is gitignored; never commit real values.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SUPABASE_SECRET_KEY must never appear here. EXPO_PUBLIC_ values are inlined into
# the app bundle where anyone can read them out of the JavaScript. The publishable
# key is safe to ship because RLS decides what it can reach; the secret key is not,
# and giving it an EXPO_PUBLIC_ prefix would put the service role on the phone.
