# Copy this file to .env.local and replace every <placeholder>.
# Never commit .env.local. Only this example file is committed.

# --- Supabase ---
# Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<placeholder>"
SUPABASE_SECRET_KEY="sb_secret_<placeholder>"
# Alternatively, use NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
# When both naming styles are set, the publishable/secret keys above take precedence.
# Public variables must be available during the Netlify build; redeploy after updates.
# The secret/service-role key must remain server-only and be available to Functions.

# --- Paystack ---
# Dashboard -> Settings -> API Keys & Integration. Use the test secret key until
# you take real payments.
PAYSTACK_SECRET_KEY="sk_test_<placeholder>"

# Paystack -> Settings -> API Keys & Integration -> Webhooks, or the "Webhook
# Secret" shown when you add a webhook URL. Locally, Paystack cannot reach
# localhost, so forward events with the CLI:
#   paystack listen --forward-to localhost:3001/api/paystack/webhook
# or send signed test events by hand. The secret is a HMAC-SHA512 key, not a
# Stripe-style "whsec_" value.
PAYSTACK_WEBHOOK_SECRET="<webhook signing secret>"

# --- Transactional email ---
# Which service actually sends order emails. One of:
#   brevo   -> uses BREVO_* below
#   mailgun -> uses MAILGUN_* below
#   none    -> delivery is off. Sends are refused and still recorded in
#              email_log as failed, so a missing email stays auditable.
# Unset is a configuration error, not a silent default: the wrong default could
# send real customer email from an account nobody intended to use.
EMAIL_PROVIDER="brevo"

# Where new-order and shipped alerts are delivered, whichever provider is active.
MERCHANT_NOTIFICATION_EMAIL="<your-inbox@example.com>"

# --- Brevo (EMAIL_PROVIDER="brevo") ---
# Brevo -> Account -> SMTP & API -> API keys. Keys start with "xkeysib-".
# This is the REST key, not the SMTP key.
BREVO_API_KEY="xkeysib-<placeholder>"
# The sender must be a verified email or an authenticated domain in Brevo,
# otherwise /v3/smtp/email rejects the request.
BREVO_FROM_EMAIL="orders@<verified-domain>"
BREVO_FROM_NAME="<Shop Name>"

# --- Mailgun (EMAIL_PROVIDER="mailgun") ---
# Mailgun -> Sending -> Domain settings -> the sending domain.
MAILGUN_DOMAIN="<sandbox or production sending domain>"
# Mailgun -> Account settings -> API keys -> Private key.
MAILGUN_API_KEY="<key-...>"
# Separate from MAILGUN_API_KEY and not interchangeable with it. The API key
# authenticates the REST API; this is the only credential the SMTP relay
# accepts, which is what Supabase Auth needs for confirmation and reset email.
# Mailgun -> Account settings -> SMTP & API.
MAILGUN_SMTP_PASSWORD="<smtp-password>"
# API origin. US is api.mailgun.net; EU accounts must use api.eu.mailgun.net.
# Getting this wrong returns 404 rather than an auth error.
MAILGUN_API_BASE="https://api.mailgun.net"
# The sender must belong to a verified domain in Mailgun.
MAILGUN_FROM_EMAIL="orders@<verified-domain>"
MAILGUN_FROM_NAME="<Shop Name>"

# --- App ---
# Absolute origin. Used for Paystack redirect URLs and every link in emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# --- Demo mode ---
# true  -> fully self-contained showcase. Catalog, orders, accounts and the
#          email log all run in the browser via localStorage. No Supabase, no
#          Paystack, no email provider, no network. Good for demos and for working
#          on the UI before the backend is wired up.
# false -> real Supabase-backed app.
NEXT_PUBLIC_DEMO_MODE="true"

# --- Supabase CLI (optional, local only) ---
# Only needed for: supabase db push
# Account Settings -> Access Tokens
# SUPABASE_ACCESS_TOKEN="sbp_<placeholder>"
# SUPABASE_PROJECT_ID="<project-ref>"

# --- Database password (local only, never deployed) ---
# Project Settings -> Database -> Connection string. Only used to apply
# supabase/migrations/*.sql. Set this in .env.local, not here, and rotate the
# publishable/secret keys that have been pasted into chat.
# SUPABASE_DB_PASSWORD="<database password>"
